# ESP32 ASR Capture Vision MVP - Environment Variables Template

# Unified Omni Configuration (preferred)
OMNI_MODEL=qwen3.5-omni-flash-realtime
OMNI_API_KEY=your_omni_api_key_here

# ASR Service (fallback if OMNI_API_KEY is not set)
ASR_API_KEY=your_dashscope_api_key_here
ASR_MODEL=qwen3.5-omni-flash-realtime
ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api/v1/services/audio/asr

# Vision Model (fallback if OMNI_API_KEY is not set)
VISION_API_KEY=your_vision_api_key_here
VISION_MODEL=qwen3.5-omni-flash-realtime
VISION_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# TTS Service (fallback if OMNI_API_KEY is not set)
TTS_API_KEY=your_tts_api_key_here
TTS_MODEL=qwen3.5-omni-flash-realtime
TTS_ENDPOINT=wss://dashscope.aliyuncs.com/api/v1/services/audio/tts
TTS_VOICE=zhifeng_emo
TTS_LANGUAGE=zh-CN
TTS_SPEED=1.0
TTS_PITCH=1.0
TTS_AUDIO_FORMAT=pcm
TTS_SAMPLE_RATE=16000
TTS_TIMEOUT_SECONDS=5.0
TTS_RETRY_ATTEMPTS=1

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# System Parameters
MAX_CONCURRENT_REQUESTS=1
COOLDOWN_SECONDS=3
CAPTURE_TIMEOUT_SECONDS=5
VISION_TIMEOUT_SECONDS=15
EVENT_BUFFER_SIZE=100
TRIGGER_ENGLISH_PHRASES=describe the view,what do I see,what's in front of me,tell me what you see
TRIGGER_CHINESE_PHRASES=描述一下景象,我看到什麼,前面是什麼,告訴我你看到什麼
TRIGGER_FUZZY_THRESHOLD=0.85

# Audio Playback
AUDIO_CHUNK_SIZE=4096
AUDIO_BUFFER_SIZE=16384
AUDIO_STREAM_TIMEOUT=10.0

# AWS EC2 Configuration (for testing)
PUBLIC_URL=http://your-ec2-public-ip:8000
