# ESP32 ASR Capture Vision MVP - Environment Variables Template
# ── Omni Realtime (Phase 1) ────────────────────────────────
OMNI_MODE=true
OMNI_MODEL=qwen3.5-omni-plus-realtime-2026-03-15
OMNI_VOICE=Cherry
OMNI_INSTRUCTIONS=你是一個配戴在眼鏡上的智能助手。用繁體中文回答，語句簡短自然。
OMNI_VAD_THRESHOLD=0.5
OMNI_VAD_SILENCE_MS=800
OMNI_ENABLE_SEARCH=false
OMNI_ENABLE_TRANSCRIPTION=true
OMNI_SESSION_REFRESH_MIN=110

#ASR (fun-asr-mtl)
ASR_API_KEY=sk-key
ASR_ENDPOINT=wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference
ASR_MODEL=fun-asr-realtime-2025-11-07


# Testing Vision Model (Qwen 3 VL Flash)
VISION_API_KEY=sk-key
VISION_MODEL=qwen3.5-flash
VISION_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# TTS Service (Qwen TTS)
TTS_API_KEY=sk-key
#TTS_API_KEY=sk-1234
TTS_MODEL=qwen3-tts-flash-realtime-2025-11-27
TTS_ENDPOINT=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
TTS_VOICE=Cherry
TTS_LANGUAGE=zh
TTS_SPEED=1.3
TTS_PITCH=1.0
TTS_AUDIO_FORMAT=pcm
TTS_SAMPLE_RATE=16000
TTS_TIMEOUT_SECONDS=120.0
TTS_RETRY_ATTEMPTS=6
TTS_FALLBACK_MAX_CHARS=5000

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO

# System Parameters
MAX_CONCURRENT_REQUESTS=5
COOLDOWN_SECONDS=10
CAPTURE_TIMEOUT_SECONDS=20
VISION_TIMEOUT_SECONDS=15
EVENT_BUFFER_SIZE=100
TRIGGER_ENGLISH_PHRASES=describe the view,what do I see,what's in front of me,tell me what you see
TRIGGER_CHINESE_PHRASES=描述一下景象,我看到什麼,前面是什麼,告訴我你看到什麼
TRIGGER_FUZZY_THRESHOLD=0.85

# Audio Playback
AUDIO_CHUNK_SIZE=4096
AUDIO_BUFFER_SIZE=16384
AUDIO_STREAM_TIMEOUT=80.0

# AWS EC2 Configuration (for testing)
PUBLIC_URL=<Your Host IP>:8080
