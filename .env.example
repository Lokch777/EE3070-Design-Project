# ============================================================
#  Qwen Omni Realtime Gateway — environment variables
# ============================================================

# ── Qwen Realtime (required) ─────────────────────────────────
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_REALTIME_MODEL=qwen3-omni-flash-realtime
QWEN_REALTIME_REGION=intl
# QWEN_REALTIME_REGION=cn       # use for mainland China endpoint
QWEN_REALTIME_VOICE=Cherry

# ── Backend server ────────────────────────────────────────────
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8765
LOG_LEVEL=INFO

# ── Device upload tuning (for reference / future use) ─────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=20
CAMERA_FPS=1
CAMERA_JPEG_QUALITY=12
